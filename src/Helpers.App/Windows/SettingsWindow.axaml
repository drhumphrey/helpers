<windows:ShellWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:windows="using:Helpers.App.Windows"
                     xmlns:vm="using:Helpers.App.ViewModels"
                     xmlns:text="using:Helpers.Core.Text"
                     xmlns:core="using:Helpers.Core"
                     x:Class="Helpers.App.Windows.SettingsWindow"
                     x:DataType="vm:SettingsViewModel"
                     Title="Helpers settings"
                     Width="720" Height="760" MinWidth="640" MinHeight="560"
                     WindowStartupLocation="CenterScreen"
                     Padding="6,0,6,10">

  <windows:ShellWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="170,0,0,0" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Margin" Value="0,14,0,2" />
    </Style>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,6" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="ScrollViewer.page">
      <Setter Property="Padding" Value="20,4,20,20" />
    </Style>
  </windows:ShellWindow.Styles>

  <TabControl x:Name="Tabs" Margin="8,0,8,8">

    <TabItem Header="Voice">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <Grid Classes="row" ColumnDefinitions="170,*,Auto">
            <TextBlock Classes="label" Text="Voice" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="Preview" Click="OnPreview" Margin="10,0,0,0" MinHeight="34" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,52">
            <TextBlock Classes="label" Text="Speed" />
            <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Speed}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{Binding SpeedText}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,52">
            <TextBlock Classes="label" Text="Volume" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding VolumePercent}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{Binding VolumeText}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Output device" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding OutputDevice}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
          <TextBlock Classes="hint" Text="A microphone choice arrives with dictation, in a later milestone." />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Unload when idle" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <NumericUpDown Minimum="0" Maximum="240" Increment="5" Value="{Binding UnloadAfterMinutes}" Width="120" FormatString="0" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="minutes. 0 keeps the voice loaded." />
            </Grid>
          </Grid>
          <TextBlock Classes="hint" Text="Unloading frees about 450 MB. The next read loads the voice again in about a second." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Reading">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <TextBlock Classes="section" Text="READABLE TEXT" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Font" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ReadingFonts}" SelectedItem="{Binding ReadingFontChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,52">
            <TextBlock Classes="label" Text="Text size" />
            <Slider Grid.Column="1" Minimum="14" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ReadingFontSize}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{Binding ReadingFontSize}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,52">
            <TextBlock Classes="label" Text="Line spacing" />
            <Slider Grid.Column="1" Minimum="1.1" Maximum="2.2" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding ReadingLineSpacing}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{Binding ReadingLineSpacing}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Background tint" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ReadingTints}" SelectedItem="{Binding ReadingTintChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Classes="hint" Text="These apply to the reading view and the sentence in the player. Lexend and Atkinson Hyperlegible are designed for easy reading." />

          <TextBlock Classes="section" Text="WHAT GETS SAID" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Code blocks" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding CodeBlockChoices}" SelectedItem="{Binding CodeBlocks}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="File paths" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding FilePathChoices}" SelectedItem="{Binding FilePaths}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Tables" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding SkipTables}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Say only how big the table is, skip the rows" />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Web addresses" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding SayLinks}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Say &quot;link&quot; instead of reading them out" />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Email addresses" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding SayEmails}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Say &quot;email address&quot; instead of reading them out" />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Numbers" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding SayNumbers}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Years, money, times and percentages the way people say them" />
            </Grid>
          </Grid>

          <TextBlock Classes="section" Text="PRONUNCIATIONS" />
          <TextBlock Classes="hint" Margin="0,0,0,6" Text="Words the voice gets wrong, and how to say them. Whole words only." />
          <ItemsControl ItemsSource="{Binding Pronunciations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="text:PronunciationEntry">
                <Grid ColumnDefinitions="170,*,60,Auto" Margin="0,2">
                  <TextBlock Classes="label" Text="{Binding Word}" FontWeight="Medium" />
                  <TextBlock Grid.Column="1" Classes="label" Text="{Binding SayAs}" />
                  <TextBlock Grid.Column="2" Classes="label" Text="Aa" IsVisible="{Binding CaseSensitive}" Opacity="0.6" ToolTip.Tip="Matches case" />
                  <Button Grid.Column="3" Content="Remove" Click="OnRemovePronunciation" MinHeight="30" FontSize="13" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="170,*,Auto,Auto" Margin="0,8,0,0">
            <TextBox Text="{Binding NewWord}" Watermark="Word" MinHeight="32" Margin="0,0,10,0" KeyDown="OnPronunciationKeyDown" />
            <TextBox Grid.Column="1" Text="{Binding NewSayAs}" Watermark="Say it as" MinHeight="32" KeyDown="OnPronunciationKeyDown" />
            <CheckBox Grid.Column="2" IsChecked="{Binding NewCaseSensitive}" Content="Match case" Margin="10,0" />
            <Button Grid.Column="3" Content="Add" Click="OnAddPronunciation" MinHeight="32" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Read button">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <TextBlock Classes="section" Text="READ BUTTON" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Show after a selection" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding ReadButtonEnabled}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="A small Read button appears next to the mouse" />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Delay" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <NumericUpDown Minimum="0" Maximum="1000" Increment="20" Value="{Binding ReadButtonDelayMs}" Width="130" FormatString="0" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="milliseconds after you let go of the mouse" />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Never in these apps" />
            <TextBox Grid.Column="1" Text="{Binding ExcludedApps}" MinHeight="32" Watermark="1Password, Bitwarden, KeePass, mstsc" />
          </Grid>
          <TextBlock Classes="hint" Text="Program names separated by commas. Password managers and remote desktop are excluded to start with." />

          <TextBlock Classes="section" Text="SHORTCUTS" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Read the selection" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding HotkeyEnabled}" OnContent="" OffContent="" />
              <TextBox Grid.Column="1" Margin="10,0,0,0" x:Name="HotkeyBox" Text="{Binding HotkeyText, Mode=OneWay}" Width="220" MinHeight="32" IsReadOnly="True"
                       KeyDown="OnHotkeyKeyDown" Watermark="Click, then press keys" ToolTip.Tip="Click here and press the keys you want" />
            </Grid>
          </Grid>
          <TextBlock Classes="hint" Text="Select text in any app and press it to hear it. With nothing selected it stops. Click the box and press new keys to change it." />
          <TextBlock Classes="hint" Text="{Binding HotkeyStatus}" IsVisible="{Binding HotkeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Open Compose" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding ComposeHotkeyEnabled}" OnContent="" OffContent="" />
              <TextBox Grid.Column="1" Margin="10,0,0,0" x:Name="ComposeHotkeyBox" Text="{Binding ComposeHotkeyText, Mode=OneWay}" Width="220" MinHeight="32" IsReadOnly="True"
                       KeyDown="OnHotkeyKeyDown" Watermark="Click, then press keys" ToolTip.Tip="Click here and press the keys you want" />
            </Grid>
          </Grid>
          <TextBlock Classes="hint" Text="Opens the Compose window, ready to send to the window you were in." />
          <TextBlock Classes="hint" Text="{Binding ComposeHotkeyStatus}" IsVisible="{Binding ComposeHotkeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="hint" Text="Ctrl+Alt is AltGr on some keyboards. If a shortcut types a character instead, pick another." />

          <TextBlock Classes="section" Text="CLIPBOARD" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Watch clipboard" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding WatchClipboardOn}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Offer to read anything new that is copied" />
            </Grid>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Look">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Vibe" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Vibes}" SelectedItem="{Binding VibeChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <StackPanel IsVisible="{Binding IsCustom}" Spacing="6" Margin="0,2,0,4">
            <Grid Classes="row" ColumnDefinitions="170,*">
              <TextBlock Classes="label" Text="Start from" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Palettes}" SelectedItem="{Binding Palette}" PlaceholderText="Pick a palette" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="170,*">
              <TextBlock Classes="label" Text="Gradient colours" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <ColorPicker Color="{Binding Colour1}" ColorSpectrumShape="Ring" IsAlphaEnabled="False" Width="120" />
                <ColorPicker Color="{Binding Colour2}" ColorSpectrumShape="Ring" IsAlphaEnabled="False" Width="120" />
                <ColorPicker Color="{Binding Colour3}" ColorSpectrumShape="Ring" IsAlphaEnabled="False" Width="120" IsEnabled="{Binding UseThirdColour}" />
                <ToggleSwitch IsChecked="{Binding UseThirdColour}" OnContent="" OffContent="" ToolTip.Tip="Use a third colour" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="hint" Text="Click a colour to open the wheel. Changes apply straight away. The switch adds a third colour." />
          </StackPanel>
          <Grid Classes="row" ColumnDefinitions="170,*" IsEnabled="{Binding IsCalm}">
            <TextBlock Classes="label" Text="Light or dark" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeChoiceValue}" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Classes="hint" Text="Neon and Custom are always dark. Calm can follow Windows or be set." />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Size" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Scales}" SelectedItem="{Binding ScaleChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,52" IsVisible="{Binding IsGradientVibe}">
            <TextBlock Classes="label" Text="Flecks" />
            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding FleckDensity}" />
            <TextBlock Grid.Column="2" Classes="label" Text="{Binding FleckDensity}" HorizontalAlignment="Right" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Move while reading" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding AnimateWhileReading}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Let the colours drift while the voice is speaking" />
            </Grid>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Player">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Hide after reading" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <NumericUpDown Minimum="0" Maximum="60" Increment="1" Value="{Binding HideAfterSeconds}" Width="120" FormatString="0" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="seconds. 0 keeps it open." />
            </Grid>
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Messages appear on" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding MessageScreens}" SelectedItem="{Binding MessagesOn}" HorizontalAlignment="Stretch" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="AI">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="AI helper" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding AiProviders}" SelectedItem="{Binding AiProviderChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <TextBlock Classes="hint" Text="Check my thinking, Tidy and Make a request need a language model. On this PC: a small model, free, nothing leaves the machine, slower. Claude: your own API key, pennies per use, and your draft goes to Anthropic." />

          <TextBlock Classes="section" Text="CLAUDE IN THE CLOUD" />
          <Grid Classes="row" ColumnDefinitions="170,*,Auto,Auto">
            <TextBlock Classes="label" Text="API key" />
            <TextBox Grid.Column="1" Text="{Binding CloudKeyEntry}" PasswordChar="•" MinHeight="32" Watermark="{Binding CloudKeyWatermark}" />
            <Button Grid.Column="2" Content="Save" Click="OnSaveKey" Margin="10,0,0,0" MinHeight="32" />
            <Button Grid.Column="3" Content="Remove" Click="OnRemoveKey" Margin="8,0,0,0" MinHeight="32" />
          </Grid>
          <TextBlock Classes="hint" Text="{Binding CloudKeyStatus}" IsVisible="{Binding CloudKeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="hint" Text="Kept in Windows Credential Manager, never in the settings file. Keys come from console.anthropic.com." />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Model" />
            <TextBox Grid.Column="1" Text="{Binding CloudModel, UpdateSourceTrigger=LostFocus}" MinHeight="32" />
          </Grid>
          <TextBlock Classes="hint" Text="claude-haiku-4-5 is the cheapest and these are simple jobs. claude-sonnet-5-5 gives better notes at more cost." />
          <TextBlock Classes="hint" Text="{Binding SpendText}" />
          <TextBlock Classes="hint" Text="What leaves your PC: only when you press a button with the cloud mark, your draft and the instructions for that button go to Anthropic over an encrypted connection. No name, no history, nothing else. Nothing is sent otherwise." />

          <TextBlock Classes="section" Text="ON THIS PC" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Model" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding LocalModelChoices}" SelectedItem="{Binding LocalModelChoice}" HorizontalAlignment="Stretch" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="170,*,Auto">
            <TextBlock Classes="label" Text="Status" />
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
              <TextBlock Classes="label" Text="{Binding LocalModelStatus}" />
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" IsVisible="{Binding IsDownloading}" Height="6" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
              <Button Content="Download" Click="OnDownloadModel" IsVisible="{Binding !IsDownloading}" MinHeight="32" />
              <Button Content="Cancel" Click="OnCancelDownload" IsVisible="{Binding IsDownloading}" MinHeight="32" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="hint" Text="{Binding LocalModelHint}" />
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Unload when idle" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <NumericUpDown Minimum="0" Maximum="240" Increment="5" Value="{Binding UnloadLocalAfterMinutes}" Width="120" FormatString="0" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="label" Text="minutes. The model uses about 3 GB while loaded. 0 keeps it loaded." />
            </Grid>
          </Grid>

          <TextBlock Classes="section" Text="INSTRUCTIONS" />
          <Grid Classes="row" ColumnDefinitions="170,*,Auto">
            <TextBlock Classes="label" Text="For" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding PromptActions}" SelectedItem="{Binding PromptActionChoice}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Reset" Click="OnResetPrompt" Margin="10,0,0,0" MinHeight="32" />
          </Grid>
          <TextBox Text="{Binding PromptText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" FontSize="13" />
          <TextBlock Classes="hint" Margin="0,4,0,0" Text="What the model is told before it sees your draft. Change it if the notes aren't the kind you want. Reset puts the original back." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Start-up">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="2">
          <Grid Classes="row" ColumnDefinitions="170,*">
            <TextBlock Classes="label" Text="Start with Windows" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
              <ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="" OffContent="" />
              <TextBlock Grid.Column="1" Margin="10,0,0,0" TextWrapping="Wrap" Classes="label" Text="Sits in the tray from sign-in. Uses no CPU until you read." />
            </Grid>
          </Grid>
          <TextBlock Classes="hint" Text="{Binding StartupStatus}" IsVisible="{Binding StartupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Classes="hint" Text="{Binding SettingsFile}" Margin="0,16,0,0" />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Privacy and licences">
      <ScrollViewer Classes="page">
        <StackPanel Spacing="6">
          <TextBlock Classes="section" Text="THIS APP" />
          <TextBlock Classes="label" Text="{Binding AboutText}" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
            <Button Content="Source code and licence" Click="OnOpenRepo" MinHeight="32" />
            <Button Content="Full privacy notes" Click="OnOpenPrivacy" MinHeight="32" />
          </StackPanel>

          <TextBlock Classes="section" Text="WHAT LEAVES YOUR PC" />
          <TextBlock Classes="label" Text="Nothing phones home. No telemetry, no crash reports, no update checks." />
          <TextBlock Classes="label" Text="The voice, the local AI model and the dictionary each download once, over an encrypted connection, when you first use them, and are checked against a checksum built into the app. After that they never touch the network." />
          <TextBlock Classes="label" Text="On this PC keeps your text on this PC. The model runs on your processor and cannot use the network." />
          <TextBlock Classes="label" Text="Claude in the cloud sends your draft, and only your draft and the instructions for that button, to Anthropic, with your own key, only when you press a button with the cloud mark. What Anthropic does with it is covered by their terms, not ours." />
          <Button Content="Anthropic's privacy policy" Click="OnOpenAnthropicPrivacy" MinHeight="30" HorizontalAlignment="Left" />
          <TextBlock Classes="label" Text="The app reads the selection in another app only when you press Read or Edit, or the shortcut. Its mouse hook sees positions and buttons; its keyboard hook sees only that a key was pressed, never which. Password fields and the excluded apps are never read." />

          <TextBlock Classes="section" Text="BUILT WITH" />
          <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:ThirdPartyComponent">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="label" Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="label" Text="{Binding Version}" Opacity="0.7" />
                      <TextBlock Classes="label" Text="{Binding Licence}" Foreground="{DynamicResource AccentTextBrush}" FontSize="13" />
                    </StackPanel>
                    <TextBlock Classes="label" Text="{Binding Role}" FontSize="14" />
                    <TextBlock Classes="label" Text="{Binding NetworkNote}" FontSize="13" Opacity="0.7" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Website" Click="OnOpenComponent" MinHeight="28" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Top" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="label" Margin="0,10,0,0" FontSize="14" Text="{Binding WindowsPartsText}" />
          <TextBlock Classes="label" FontSize="13" Opacity="0.7" Text="Open English WordNet: Global WordNet Association, CC BY 4.0, derived from Princeton WordNet 3.0. British hyphenation patterns: Dominik Wujastyk and Graham Toal, MIT." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</windows:ShellWindow>
