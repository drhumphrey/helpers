<windows:ShellWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:windows="using:Helpers.App.Windows"
                     x:Class="Helpers.App.Windows.FirstRunWindow"
                     Title="Welcome to Helpers"
                     Width="600" SizeToContent="Height" CanResize="False"
                     WindowStartupLocation="CenterScreen"
                     Padding="24,0,24,20">

  <windows:ShellWindow.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Margin" Value="0,18,0,8" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </windows:ShellWindow.Styles>

  <StackPanel>
    <TextBlock Text="Welcome to Helpers" FontSize="26" FontWeight="SemiBold" />
    <TextBlock Classes="hint" Margin="0,4,0,0" Text="Three things to choose. You can change them all later in Settings." />

    <TextBlock Classes="label" Text="1. PICK A VOICE" />
    <WrapPanel x:Name="VoiceChips" />
    <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
      <Button Content="Hear it" Click="OnPreview" />
      <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" Text="The voice downloads in the background the first time. About 350 MB, once." />
    </Grid>

    <TextBlock Classes="label" Text="2. HOW TO START READING" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
      <StackPanel>
        <TextBlock Text="Show a Read button when I select text" FontSize="15" />
        <TextBlock Classes="hint" Text="A small button appears next to your mouse. Nothing is read until you click it. Ctrl+Alt+Space reads a selection too." />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" x:Name="ReadButtonSwitch" IsChecked="True" OnContent="" OffContent="" VerticalAlignment="Top" Margin="12,0,0,0" />
    </Grid>
    <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
      <StackPanel>
        <TextBlock Text="Start with Windows" FontSize="15" />
        <TextBlock Classes="hint" Text="Sits in the tray from sign-in. Uses no CPU until you read." />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" x:Name="StartupSwitch" OnContent="" OffContent="" VerticalAlignment="Top" Margin="12,0,0,0" />
    </Grid>

    <TextBlock Classes="label" Text="3. ONE THING THAT WOULD USE THE INTERNET" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
      <StackPanel>
        <TextBlock Text="Check for a new version once a day" FontSize="15" />
        <TextBlock Classes="hint" Text="Asks GitHub for the latest version number, once a day. That is the only thing this app would ever send anywhere on its own, and only if you say yes. Off, it never does." />
      </StackPanel>
      <ToggleSwitch Grid.Column="1" x:Name="UpdatesSwitch" OnContent="" OffContent="" VerticalAlignment="Top" Margin="12,0,0,0" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,24,0,0">
      <Button Content="Done" Click="OnDone" Classes="main" />
    </StackPanel>
  </StackPanel>
</windows:ShellWindow>
