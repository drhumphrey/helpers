<overlays:OverlayWindow xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:overlays="using:Helpers.App.Overlays"
                        x:Class="Helpers.App.Spike.FocusSpikeWindow"
                        Title="Helpers focus spike"
                        SizeToContent="WidthAndHeight">
  <Border Margin="24" Padding="18,16" Width="400"
          CornerRadius="14"
          Background="#E6171922"
          BorderBrush="#5919E6FF" BorderThickness="1"
          BoxShadow="0 0 26 0 #4019E6FF, 0 12 32 0 #8C000000">
    <StackPanel Spacing="10">
      <TextBlock Text="Focus spike" FontSize="18" FontWeight="SemiBold" Foreground="#F2F4F8" />
      <TextBlock x:Name="FocusText" FontSize="15" Foreground="#A9B1BD" TextWrapping="Wrap" Text="Focus is in: …" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button x:Name="ClickMe" Content="Click me" Click="OnClickMe" MinHeight="36" Padding="14,0" />
        <TextBlock x:Name="ClickCount" VerticalAlignment="Center" Foreground="#F2F4F8" Text="0 clicks" />
      </StackPanel>
      <TextBlock FontSize="13" Foreground="#A9B1BD" TextWrapping="Wrap"
                 Text="Click the button. If the line above still names your other app afterwards, this overlay never took focus." />
      <TextBlock x:Name="StyleText" FontSize="13" Foreground="#A9B1BD" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</overlays:OverlayWindow>
